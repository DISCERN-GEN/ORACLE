# Copy to .env and replace the development token before any non-local use.
ORACLE_ENV=development
ORACLE_API_TOKEN=change-this-long-random-token
DATABASE_URL=postgresql://oracle:change-me-before-use@postgres:5432/oracle
POSTGRES_PASSWORD=change-me-before-use
VALKEY_URL=redis://valkey:6379/0

# Public Polymarket read-only endpoints. No signing keys are used by this build.
POLYMARKET_GAMMA_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_URL=https://clob.polymarket.com
POLYMARKET_DATA_URL=https://data-api.polymarket.com
POLYMARKET_GEO_URL=https://polymarket.com/api/geoblock

# Trading safeguards. Real execution is deliberately absent/disabled.
EXECUTION_MODE=paper
ENABLE_LIVE_EXECUTION=false
LIVE_LEGAL_REVIEW_APPROVED=false
PAPER_INITIAL_BANKROLL=10000
PAPER_SESSION_HOURS=12
PAPER_MAX_ORDER_NOTIONAL=100
PAPER_MAX_SINGLE_MARKET_EXPOSURE=500
PAPER_MAX_PORTFOLIO_EXPOSURE=2500
PAPER_MAX_DAILY_LOSS=200
PAPER_MAX_KELLY_FRACTION=0.02
MARKET_DATA_MAX_AGE_SECONDS=30

# Optional LLM reasoning provider. Leave unset until a provider and model are selected.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
